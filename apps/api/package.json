{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian API - NestJS backend",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "set-password": "npx ts-node src/auth/session-token.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./jest-e2e.json --runInBand",
    "test:analysis": "npx ts-node test/manual/run-analysis.ts",
    "analyze": "npx ts-node test/manual/analyze.ts",
    "backtest": "npx ts-node test/manual/backtest.ts",
    "backtest:plans": "npx ts-node test/manual/backtest-plans.ts",
    "forward-test": "npx ts-node test/manual/forward-test.ts",
    "journal": "npx ts-node test/manual/journal.ts",
    "golden": "npx ts-node --transpile-only scripts/golden-report.ts",
    "score": "npx ts-node --transpile-only scripts/score-outcomes.ts",
    "interval": "npx ts-node --transpile-only test/manual/interval-check.ts",
    "cost-sweep": "npx ts-node --transpile-only test/manual/cost-sweep.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@aws-sdk/client-secrets-manager": "^3.1106.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "trading-signals": "8.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "jest": "^30.0.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*trading-signals)"
    ]
  }
}
