# Lambda container image.
#
# ─── Why a container and not a zip of bundled JavaScript ─────────────────
# The usual path is esbuild: squash the app into one index.js and upload it.
# That fails here, and not for a fixable reason: `@prisma/client` is a stub
# that loads `.prisma/client`, a package GENERATED by `prisma generate` at
# install time. esbuild cannot resolve a module that does not exist yet, and
# CDK's bundler offers no hook to run the generator after its install step.
#
# A container removes the question. It runs the same npm install and
# `prisma generate` you run locally, so nothing has to be inlined,
# hand-copied, or marked external. Lambda has supported container images up
# to 10GB since 2020 and it is the ordinary choice for Node apps with
# generated or native dependencies.
#
# The cost is a slightly slower cold start and needing Docker at deploy time.
# At six scheduled runs a day, neither matters.

# ── Stage 1: build ───────────────────────────────────────────────────────
# A full Node image, because building needs a package manager, the compiler
# and the Prisma CLI. None of that ships to production.
FROM node:22-slim AS builder

# openssl is required by Prisma's CLI during generate.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

WORKDIR /build

# Manifests first, so Docker caches the dependency install and only redoes it
# when a dependency actually changes — not on every source edit.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter api...

COPY apps/api apps/api

# Generates .prisma/client — the step the bundler could not perform.
RUN pnpm --filter api exec prisma generate

RUN pnpm --filter api build

# Production dependencies only: the compiler, test framework and Prisma CLI
# are build tools and have no business in the deployed image.
# --legacy: pnpm 10 requires it for a workspace that does not inject its
# dependencies. This one has no internal packages to inject.
RUN pnpm --filter api --prod deploy --legacy /prod

# `deploy` builds a fresh node_modules, which does not include the generated
# client — so copy it across. Without this the image starts and then fails on
# the first query with "Cannot find module '.prisma/client/default'", which is
# exactly the failure that ruled out esbuild bundling.
# `deploy` builds a fresh node_modules which does NOT include the generated
# client, so copy it across. pnpm keeps it inside its content-addressed store
# (node_modules/.pnpm/@prisma+client@<hash>/node_modules/.prisma), so the path
# is found rather than hardcoded — the hash changes with every version bump.
#
# Without this the image starts fine and dies on the first query with
# "Cannot find module '.prisma/client/default'" — the exact failure that ruled
# out esbuild bundling, just moved.
RUN cp -r "$(find /build/node_modules/.pnpm -maxdepth 4 -type d -name .prisma | head -1)" \
        /prod/node_modules/.prisma \
    && cd /prod && node -e "require('@prisma/client'); console.log('prisma client resolves')"


# ── Stage 2: runtime ─────────────────────────────────────────────────────
# AWS's own base image. It ships the Lambda Runtime Interface Client, which is
# the loop that talks to the Lambda service, fetches events, and calls your
# handler. That is why the CMD below is a function name and not a script.
FROM public.ecr.aws/lambda/nodejs:22

# LAMBDA_TASK_ROOT is /var/task — where the runtime looks for your code.
COPY --from=builder /prod/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=builder /build/apps/api/dist ${LAMBDA_TASK_ROOT}/dist
COPY --from=builder /build/apps/api/prisma ${LAMBDA_TASK_ROOT}/prisma

# `trading-signals` is ESM-only, and this app compiles to CommonJS. Node 22.12+
# can require() an ES module, but AWS's runtime bootstrap DISABLES it by
# default and re-enables it only when NODE_OPTIONS asks:
#
#   case $NODE_OPTIONS in
#   *--experimental-require-module*) EXPERIMENTAL_ARGS+=(--experimental-require-module) ;;
#   *)                               EXPERIMENTAL_ARGS+=(--no-experimental-require-module) ;;
#   esac
#                                      -- /var/runtime/bootstrap, AWS base image
#
# So this is the documented opt-in, not a workaround. It is set on the IMAGE
# rather than in the CDK stack because it is a property of this app's
# dependencies, not of how it happens to be deployed — the same requirement
# would follow the image anywhere it runs.
ENV NODE_OPTIONS="--experimental-require-module"

# "file.exportedFunction" — the path is relative to LAMBDA_TASK_ROOT and has
# no extension. This is the only line that tells AWS what to call.
CMD [ "dist/src/lambda.handler" ]
