// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TradeAnalysis {
  id         String   @id @default(cuid())
  coin       String
  timeframe  String
  entryPrice Float
  tp1        Float
  tp2        Float
  tp3        Float
  stopLoss   Float
  leverage   Int
  suggestion String   // LONG, SHORT, WAIT
  reasoning  String   @db.Text

  // Indicator values at time of analysis
  rsiValue  Float?
  bbUpper   Float?
  bbMiddle  Float?
  bbLower   Float?
  atrValue  Float?

  // Metadata
  priceAtAnalysis Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([coin])
  @@index([createdAt])
}

model CoordinatorRun {
  id              String   @id @default(cuid())
  symbol          String
  timeframe       String
  regime          String
  strategyRoute   String
  checklistStatus String?
  totalScore      Int?
  shouldInvokeAI  Boolean
  aiAction        String?
  aiConfidence    Int?

  coordinatorPayload Json
  aiPayload          Json?

  durationMs   Int
  errorMessage String?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  /// ── The scored outcome, written by the job and never on a read path ──
  ///
  /// Scoring one row costs 3.9 ms; fetching the candles it scores costs ~360 ms
  /// of network. Recomputing on every read made the history page a 32-second
  /// wait, 92% of it spent re-deriving results that finished days ago.
  ///
  /// `scoredAt` is the settled marker, not just a timestamp: null means "score
  /// me". A row whose candles could not be fetched keeps `outcome` at
  /// UNSCOREABLE but leaves `scoredAt` null, so it is retried rather than
  /// frozen at a failure. See OutcomeScorerService.

  /// Every plan's result, in the same order as `coordinatorPayload.plans`.
  /// The detail page renders one per plan, so the lead plan alone is not
  /// enough. Shape is PlanResult[] from outcome.ts.
  outcomePayload Json?
  /// When the job last settled this row. Null means it still needs scoring.
  scoredAt DateTime?

  /// The lead plan's result, lifted out of `outcomePayload` so the list and
  /// the stats endpoint can filter and GROUP BY without opening the JSON.
  /// Written by one function beside the JSON, never derived twice.
  outcome          String?
  outcomeDirection String?
  /// Result in R before costs. Null until the trade opens.
  grossR           Float?
  /// After costs. This is the number the scoreboard adds up.
  netR             Float?
  targetsHit       Int?
  /// When the first entry step filled. Null until it does.
  entryFilledAt    DateTime?

  @@index([symbol, createdAt])
  /// The job's query: unsettled rows, plus the ones that can still move.
  @@index([scoredAt])
  @@index([outcome])
  @@index([strategyRoute, createdAt])
  @@index([aiAction, createdAt])
}

/// One number from Binance's futures-flow endpoints, at one moment, for one coin.
///
/// Deliberately narrow. All four sources return the same thing — a timestamp
/// and a number — so one table with a `metric` label beats four typed tables
/// that would need joining back together for every study.
///
/// The key is (symbol, metric, ts), so re-collecting the same window inserts
/// nothing new. That is what lets the collector overlap its windows and heal
/// its own gaps without bookkeeping.
model FlowSample {
  symbol String
  /// openInterest | longShortRatio | takerBuySellRatio | premium
  metric String
  ts     DateTime
  value  Float

  @@id([symbol, metric, ts])
  @@index([metric, ts])
}
