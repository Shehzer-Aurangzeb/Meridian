// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TradeAnalysis {
  id         String   @id @default(cuid())
  coin       String
  timeframe  String
  entryPrice Float
  tp1        Float
  tp2        Float
  tp3        Float
  stopLoss   Float
  leverage   Int
  suggestion String   // LONG, SHORT, WAIT
  reasoning  String   @db.Text

  // Indicator values at time of analysis
  rsiValue  Float?
  bbUpper   Float?
  bbMiddle  Float?
  bbLower   Float?
  atrValue  Float?

  // Metadata
  priceAtAnalysis Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([coin])
  @@index([createdAt])
}

model CoordinatorRun {
  id              String   @id @default(cuid())
  symbol          String
  timeframe       String
  regime          String
  strategyRoute   String
  checklistStatus String?
  totalScore      Int?
  shouldInvokeAI  Boolean
  aiAction        String?
  aiConfidence    Int?

  coordinatorPayload Json
  aiPayload          Json?

  durationMs   Int
  errorMessage String?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  /// The scored outcome, written by OutcomeScorerService, never on a read path.

  /// One result per plan, same order as `coordinatorPayload.plans`.
  /// Shape is PlanResult[] from outcome.ts.
  outcomePayload Json?
  /// Null means "score me" — including a row whose candles would not load,
  /// so a failed fetch is retried instead of frozen as a verdict.
  scoredAt DateTime?

  /// How the saved statement resolved. Kept: it is the resolution machinery,
  /// not a trade field.
  ///
  /// `grossR`, `netR`, `targetsHit`, `entryFilledAt` and `outcomeDirection`
  /// were dropped on 6 September 2026 — they described R-multiples for trades
  /// the system no longer plans. The 843-row forward-test record was dumped to
  /// `~/meridian-archive/coordinator-run-20260905.sql` first.
  outcome          String?

  @@index([symbol, createdAt])
  /// The list pages on (createdAt, id) and orders by createdAt DESC.
  @@index([createdAt])
  /// The job's query: unsettled rows, plus the ones that can still move.
  @@index([scoredAt])
  @@index([outcome])
  @@index([strategyRoute, createdAt])
  @@index([aiAction, createdAt])
}

/// One number from Binance's futures-flow endpoints, at one moment, for one coin.
///
/// Deliberately narrow. All four sources return the same thing — a timestamp
/// and a number — so one table with a `metric` label beats four typed tables
/// that would need joining back together for every study.
///
/// The key is (symbol, metric, ts), so re-collecting the same window inserts
/// nothing new. That is what lets the collector overlap its windows and heal
/// its own gaps without bookkeeping.
model FlowSample {
  symbol String
  /// openInterest | longShortRatio | takerBuySellRatio | premium
  metric String
  ts     DateTime
  value  Float

  @@id([symbol, metric, ts])
  @@index([metric, ts])
}

/// Resting order-book notional in one price shell, for one coin, in one bucket.
///
/// The archive publishes CUMULATIVE depth at +-1..+-5% of mid; `shell` holds the
/// INCREMENTAL band between two of those, so shell 3 is the notional resting in
/// (2%, 3%] and nothing below it. Five shells per side per bucket.
///
/// This is the shape `FlowSample`'s three bookDepth scalars threw away, and the
/// reason a separate table exists rather than more metric labels: a heatmap
/// needs the profile, and a (metric, ts) key cannot carry one without encoding
/// the shell into the metric name.
///
/// `ts` is the END of the 5-minute bucket, matching the bookDepth rows in
/// `FlowSample` — a bucket stamped at its start is readable before it finished.
model BookProfile {
  symbol String
  ts     DateTime
  /// 1..5, the upper bound of the shell in percent from mid.
  shell       Int
  bidNotional Float
  askNotional Float

  @@id([symbol, ts, shell])
  @@index([symbol, ts])
}
