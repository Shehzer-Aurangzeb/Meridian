// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model TradeAnalysis {
  id         String   @id @default(cuid())
  coin       String
  timeframe  String
  entryPrice Float
  tp1        Float
  tp2        Float
  tp3        Float
  stopLoss   Float
  leverage   Int
  suggestion String   // LONG, SHORT, WAIT
  reasoning  String   @db.Text

  // Indicator values at time of analysis
  rsiValue  Float?
  bbUpper   Float?
  bbMiddle  Float?
  bbLower   Float?
  atrValue  Float?

  // Metadata
  priceAtAnalysis Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([coin])
  @@index([createdAt])
}

model CoordinatorRun {
  id              String   @id @default(cuid())
  symbol          String
  timeframe       String
  regime          String
  strategyRoute   String
  checklistStatus String?
  totalScore      Int?
  shouldInvokeAI  Boolean
  aiAction        String?
  aiConfidence    Int?

  coordinatorPayload Json
  aiPayload          Json?

  durationMs   Int
  errorMessage String?

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  entryFilledAt DateTime?

  @@index([symbol, createdAt])
  @@index([strategyRoute, createdAt])
  @@index([aiAction, createdAt])
}
