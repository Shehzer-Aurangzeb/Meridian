# Environment variables
.env
.env.local
.env.production
.env.*.local

# Build output
dist/

# Prisma
*.db
*.db-journal
temp/
# Bulk result CSVs — regenerable, and some are tens of megabytes.
test/manual/results/*
# ...except the golden set and its archives. It is the instrument that detects
# scoring drift, and an instrument that exists on one laptop is not one. A
# directory-level ignore cannot be undone by a later negation, which is why
# this is `results/*` rather than `results/`.
!test/manual/results/golden-set*.json

# CLI run log (JSONL)
logs/
