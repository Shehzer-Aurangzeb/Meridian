# Meridian Web - Environment Variables
# Copy this file to .env.local and adjust values as needed

# Backend URL (server-side only - used by BFF API routes)
# This is NOT exposed to the browser
BACKEND_URL=http://localhost:3001

# Public API URL (client-side - only used for SSE streams)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Feature Flags
# Set to 'true' or 'false' to enable/disable features
# Core features (enabled by default)
NEXT_PUBLIC_FEATURE_DASHBOARD=true
NEXT_PUBLIC_FEATURE_ANALYSIS=true
NEXT_PUBLIC_FEATURE_HISTORY=true

# Features pending backend support (disabled by default)
NEXT_PUBLIC_FEATURE_ALERTS=false
NEXT_PUBLIC_FEATURE_STRATEGIES=false
NEXT_PUBLIC_FEATURE_SETTINGS=false
