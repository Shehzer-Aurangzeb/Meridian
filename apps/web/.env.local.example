# Meridian Web - Environment Variables
# Copy this file to .env.local and adjust values as needed

# Backend URL. Server-side only: the browser never sees this, and never calls
# the API directly — every request goes through the /api routes in this app.
# Deployed, this is the API Gateway URL from the CDK stack's ApiUrl output.
BACKEND_URL=http://localhost:3001

# Feature flags — 'true' or 'false'. A flag is on only when the screen behind
# it reads a live endpoint; turning one on early gives you a screen that 404s.
# See lib/feature-flags.ts for why each is where it is.
NEXT_PUBLIC_FEATURE_DASHBOARD=true

# Wired to the analyses API.
# lib/hooks/use-analyses.ts.
NEXT_PUBLIC_FEATURE_ANALYSIS=true
NEXT_PUBLIC_FEATURE_HISTORY=true

# No persistence for a saved list yet.
NEXT_PUBLIC_FEATURE_WATCHLIST=false

# No backend at all.
NEXT_PUBLIC_FEATURE_ALERTS=false
NEXT_PUBLIC_FEATURE_STRATEGIES=false
NEXT_PUBLIC_FEATURE_SETTINGS=false
