{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // *.check.ts are node self-checks run with --experimental-strip-types, which
  // requires the explicit `.ts` in relative imports that tsc rejects without
  // allowImportingTsExtensions. They are not part of the app build; node type
  // checks them by running them.
  "exclude": ["node_modules", "**/*.check.ts"]
}
