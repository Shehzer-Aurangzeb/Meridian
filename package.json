{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered crypto trading analysis assistant",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:apps": "pnpm --filter api --filter web --parallel dev",
    "build": "pnpm run --parallel build",
    "start": "pnpm run --parallel start",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "analyze": "pnpm --filter api analyze",
    "backtest": "pnpm --filter api backtest"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
